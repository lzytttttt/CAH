# Cognitive Atrium - 环境变量示例（不含真实凭据）
# 复制为 .env 后按需修改。生产环境请通过进程环境变量注入，不要把 .env 提交到版本库。

# ---- 服务与数据 ----
# HTTP 端口（默认 4310，仅监听回环地址）
CA_PORT=4310
CA_HOST=127.0.0.1
# 数据目录：包含 demo/ 与 live/ 两个物理隔离的 SQLite + 内容寻址对象目录
CA_DATA_DIR=./data
# 本地会话签名密钥（必填；留空时开发模式自动生成并写入 data/session-secret）
CA_SESSION_SECRET=
# 允许的浏览器来源（逗号分隔），用于 Origin 校验与 CORS
CA_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://127.0.0.1:5173
# 是否允许 http:// 回环地址上的本地模型服务（默认 true，仅回环）
CA_ALLOW_HTTP_LOOPBACK=true
# 额外允许的内网模型服务主机（逗号分隔的精确 host:port，默认空）
CA_ALLOWED_PROVIDER_HOSTS=
# 日志级别 debug|info|warn|error
CA_LOG_LEVEL=info

# ---- 模型连接（Live 模式）----
# 后端读取凭据：CA_OPENAI_API_KEY 或 CA_OPENAI_API_KEY_FILE 指向的受限文件。
# 浏览器永远只能看到“已配置/未配置”和掩码状态。
CA_OPENAI_BASE_URL=https://api.openai.com/v1
CA_OPENAI_MODEL=
CA_OPENAI_API_KEY=
CA_OPENAI_API_KEY_FILE=
# 可选：请求超时覆盖（毫秒）
CA_PROVIDER_FIRST_EVENT_TIMEOUT_MS=30000
CA_PROVIDER_IDLE_TIMEOUT_MS=45000
CA_PROVIDER_TOTAL_TIMEOUT_MS=180000

# ---- Demo ----
# 首次启动时把内置场景与 Demo 事件夹具写入 demo 命名空间（仅 demo，不触碰 live）
CA_SEED_DEMO=true

# ---- 测试 ----
# 集成测试使用的临时数据目录（留空则使用系统临时目录）
CA_TEST_DATA_DIR=
